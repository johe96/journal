#!/bin/sh
# Create a Hugo post from within this directory.
# Usage: ./new-post my-new-post.md

set -eu

if [ "$#" -ne 1 ]; then
  echo "Usage: $0 POST-FILE.md" >&2
  exit 64
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
site_root=$(CDPATH= cd -- "$script_dir/../.." && pwd)

exec hugo --source "$site_root" new content "posts/$1"
